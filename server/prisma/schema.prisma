generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  PATIENT
  HOSPITAL
  ADMIN
}

enum HospitalStatus {
  PENDING_VERIFICATION
  VERIFIED
  REJECTED
  CHANGES_REQUESTED
  SUSPENDED
}

enum Availability {
  AVAILABLE
  TEMPORARILY_UNAVAILABLE
  NOT_OFFERED
  COMING_SOON
}

enum HospitalTreatmentApproval {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  role              Role
  mustChangePassword Boolean @default(false)
  createdAt         DateTime @default(now())
  patient      Patient?
  hospital     Hospital?
  notifications Notification[]
  messagesSent Message[] @relation("MessageSender")
  documentAccessLogs DocumentAccessLog[]
  @@index([role])
}

model Patient {
  id        String   @id @default(cuid())
  userId    String   @unique
  firstName String
  lastName  String
  country   String?
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  cases     PatientCase[]
  reviews   Review[]
  conversations Conversation[]
}

model Hospital {
  id                      String         @id @default(cuid())
  userId                  String         @unique
  name                    String
  slug                    String         @unique
  city                    String
  state                   String?
  country                 String         @default("India")
  description             String?
  status                  HospitalStatus @default(PENDING_VERIFICATION)
  internationalSupport    Boolean        @default(false)
  phone                   String?
  address                 String?
  website                 String?
  hospitalType            String?
  beds                    Int?
  icuBeds                 Int?
  facilities              String?
  accreditation           String?
  languages               String?
  user                    User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  verification            HospitalVerification?
  treatments              HospitalTreatment[]
  cases                   PatientCase[]
  reviews                 Review[]
  conversations           Conversation[]
  @@index([status])
  @@index([city])
}

model HospitalVerification {
  id         String         @id @default(cuid())
  hospitalId String         @unique
  status     HospitalStatus @default(PENDING_VERIFICATION)
  notes      String?
  reviewedAt DateTime?
  hospital   Hospital       @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
}

model Specialty {
  id          String      @id @default(cuid())
  name        String      @unique
  treatments  Treatment[]
}

model Treatment {
  id          String              @id @default(cuid())
  name        String
  slug        String              @unique
  description String?
  specialtyId String
  specialty   Specialty           @relation(fields: [specialtyId], references: [id])
  hospitals   HospitalTreatment[]
  cases       PatientCase[]
  @@index([specialtyId])
}

model HospitalTreatment {
  id                   String       @id @default(cuid())
  hospitalId           String
  treatmentId          String
  availability         Availability  @default(AVAILABLE)
  approvalStatus       HospitalTreatmentApproval @default(APPROVED)
  minEstimatedCost     Decimal?      @db.Decimal(12, 2)
  maxEstimatedCost     Decimal?      @db.Decimal(12, 2)
  currency             String        @default("INR")
  hospitalStay         String?
  recoveryEstimate     String?
  consultationEstimate Decimal?     @db.Decimal(12, 2)
  inclusions           String?
  exclusions           String?
  hospital             Hospital      @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  treatment            Treatment     @relation(fields: [treatmentId], references: [id], onDelete: Cascade)
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
  @@unique([hospitalId, treatmentId])
  @@index([treatmentId, availability, approvalStatus])
  @@index([hospitalId, availability])
}

model PatientCase {
  id          String   @id @default(cuid())
  patientId   String
  hospitalId  String
  treatmentId String
  status      String   @default("DRAFT")
  description String?
  patient     Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  hospital    Hospital @relation(fields: [hospitalId], references: [id])
  treatment   Treatment @relation(fields: [treatmentId], references: [id])
  createdAt   DateTime @default(now())
  reports     MedicalReport[]
  responses   HospitalResponse[]
  appointments Appointment[]
  reviews     Review[]
  conversation Conversation?
  @@index([patientId, status])
  @@index([hospitalId, status])
  @@index([treatmentId])
}

model MedicalReport {
  id           String      @id @default(cuid())
  caseId       String
  originalName String
  storageKey   String
  mimeType     String
  size         Int
  category     String      @default("OTHER")
  createdAt    DateTime    @default(now())
  patientCase  PatientCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  accessLogs   DocumentAccessLog[]
  @@index([caseId])
}

model DocumentAccessLog {
  id        String        @id @default(cuid())
  reportId  String
  userId    String
  action    String
  createdAt DateTime      @default(now())
  report    MedicalReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([reportId, userId])
}

model HospitalResponse {
  id                        String      @id @default(cuid())
  caseId                    String
  summary                   String
  recommendedNextStep       String
  estimatedTreatmentCost    Decimal?    @db.Decimal(12, 2)
  estimatedHospitalStay     String?
  additionalInformation     String?
  createdAt                 DateTime    @default(now())
  patientCase               PatientCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
}

model Appointment {
  id          String      @id @default(cuid())
  caseId      String
  preferredAt DateTime
  status      String      @default("REQUESTED")
  type        String      @default("HOSPITAL_CONSULTATION")
  notes       String?
  createdAt   DateTime    @default(now())
  patientCase PatientCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  body      String
  readAt    DateTime?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, readAt])
}

model Conversation {
  id          String      @id @default(cuid())
  caseId      String      @unique
  patientId   String
  hospitalId  String
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  patient     Patient     @relation(fields: [patientId], references: [id], onDelete: Cascade)
  hospital    Hospital    @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  patientCase PatientCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  messages    Message[]
  @@index([patientId])
  @@index([hospitalId])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  senderId       String
  content        String       @db.Text
  readAt         DateTime?
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User         @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  @@index([conversationId, createdAt])
}

model Review {
  id                   String      @id @default(cuid())
  caseId               String
  patientId             String
  hospitalId            String
  overallRating         Int
  hospitalRating        Int
  communicationRating   Int
  treatmentExperience   Int
  writtenReview         String?
  createdAt             DateTime    @default(now())
  patientCase           PatientCase @relation(fields: [caseId], references: [id])
  patient               Patient     @relation(fields: [patientId], references: [id])
  hospital              Hospital    @relation(fields: [hospitalId], references: [id])
}